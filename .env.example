# Names of the settings the app needs. NEVER put real values in this file.
# Real values go in Vercel → Project → Settings → Environment Variables
# (see docs/SETUP.md for where to find each one).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Account Manager CRM handoff (packages + sending new clients). The key must
# match HANDOFF_SECRET on the ReviewSend server (Railway).
AM_CRM_HANDOFF_URL=
AM_CRM_HANDOFF_KEY=
